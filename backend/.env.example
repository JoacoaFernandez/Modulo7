PORT=3000
DATABASE_URL="postgresql://analitica:analitica@localhost:5432/analitica"
CORS_ORIGINS=http://localhost:5173

# Eventos: Postman simula la cola.
EVENTS_HTTP_INGEST=true
# RABBITMQ_URL=amqps://analytics-reader:CAMBIAR@host:5671/uadenet
RABBITMQ_QUEUE=analytics.all-events.v1
RABBITMQ_PREFETCH=20
RABBITMQ_MAX_ATTEMPTS=3
INBOX_STORE_UNKNOWN=false

# Mocks por servicio (true = backend/mocks/<servicio>/*.json).
CORE_MOCK=true
BACKOFFICE_MOCK=true
ACADEMIC_MOCK=true
MOCKS_DIR=./mocks

# CORE real (sólo con CORE_MOCK=false). El secreto va en el entorno, no en Git.
CORE_BASE_URL=https://core-api-production-e458.up.railway.app
CORE_CLIENT_ID=analytics-service
CORE_CLIENT_SECRET=
CORE_JWT_ISSUER=https://core-api-production-e458.up.railway.app
CORE_JWT_AUDIENCE=uadenet

# Backoffice y Gestión Académica reales (sólo con *_MOCK=false).
BACKOFFICE_BASE_URL=
ACADEMIC_BASE_URL=

# Firma del gateway de CORE (X-Core-Signature) en /api/v1/*: secreto compartido con CORE, va en el entorno, no en Git.
# Vacío = no se valida (se avisa al arrancar).
CORE_GATEWAY_SECRET=

# Cookie de refresh: "none" sólo si el SPA y el backend quedan en sitios distintos (exige HTTPS).
AUTH_COOKIE_SAMESITE=lax

# Snapshots y tablero.
WALLET_SNAPSHOT_ENABLED=true
WALLET_SNAPSHOT_BACKFILL_MONTHS=6
DASHBOARD_FIRST_MONTH=2026-03
DINING_REVENUE_NET_OF_ATTENDANCE=false

# --- Producción (valores reales conocidos; sin secretos) ---
# Poné *_MOCK=false y estas URLs. DATABASE_URL, CORE_CLIENT_SECRET, CORE_GATEWAY_SECRET y RABBITMQ_URL van en el entorno
# del deploy. Con el front y el back en dominios distintos la cookie de refresh necesita SameSite=None (exige HTTPS).
# CORE_MOCK=false
# BACKOFFICE_MOCK=false
# ACADEMIC_MOCK=false
# CORE_BASE_URL=https://core-api-production-e458.up.railway.app
# CORE_JWT_ISSUER=https://core-api-production-e458.up.railway.app
# BACKOFFICE_BASE_URL=https://backend-integracion-41b2dbda.up.railway.app
# ACADEMIC_BASE_URL=https://desarrolloaplicacionesiibackend-production.up.railway.app
# AUTH_COOKIE_SAMESITE=none
# CORS_ORIGINS=https://<dominio-del-frontend>
# EVENTS_HTTP_INGEST=false
