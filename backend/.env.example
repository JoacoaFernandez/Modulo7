# Copiar a backend/.env (no se versiona). Sin una URL, ese módulo se simula con su mock.

# CORE (módulo 10): base de /internal/v1/*, para pedir el token de servicio.
CORE_BASE_URL=
# Credenciales de servicio que asignó CORE a Analítica. El secret nunca va al repo.
ANALYTICS_CLIENT_ID=analytics-service
ANALYTICS_CLIENT_SECRET=

# Backoffice (módulo 8): URL directa de su backend (sin gateway), por ejemplo http://localhost:4008.
BACKOFFICE_URL=
# Gestión Académica (módulo 9): URL directa de su backend (sin gateway).
ACADEMIC_URL=

PORT=3000
