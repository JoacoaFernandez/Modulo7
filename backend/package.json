{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "docs:payloads": "tsx scripts/generate-payload-docs.ts",
    "docs:postman": "tsx scripts/generate-postman.ts",
    "docs": "npm run docs:payloads && npm run docs:postman",
    "backfill:core": "tsx scripts/backfill-from-core.ts",
    "db:up": "docker compose up -d",
    "db:migrate": "prisma migrate dev",
    "db:demo": "tsx prisma/demo-seed.ts",
    "db:demo:clear": "tsx prisma/demo-seed.ts --clear",
    "postinstall": "prisma generate",
    "mocks:generate": "tsx scripts/generate-demo-mocks.ts",
    "mocks:check": "tsx scripts/check-mocks.ts"
  },
  "keywords": [],
