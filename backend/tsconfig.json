{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": ["**/*.ts"],
  // Seeds y generadores de docs: asumen el contrato viejo (sourceModule/payload) y no compilan hasta la Fase D de docs/INTEGRACION.md.
  "exclude": [
    "node_modules",
    "dist",
    "prisma/seed.ts",
    "prisma/demo-seed.ts",
    "scripts/generate-payload-docs.ts",
    "scripts/generate-postman.ts"
  ]
}
